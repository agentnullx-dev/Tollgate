# --- Core infrastructure -------------------------------------------------
DATABASE_URL="postgresql://tollgate:tollgate@localhost:5432/tollgate?schema=public"
REDIS_URL="redis://localhost:6379/0"

# --- Gateway behaviour ---------------------------------------------------
# How long a pre-flight reservation holds budget headroom before it expires.
RESERVATION_TTL_SECONDS=300
# Per-API-key request ceiling (fixed one-minute window).
API_RATE_LIMIT_PER_MINUTE=1200
# Read-through cache lifetime for agents, budgets and API keys.
CACHE_TTL_SECONDS=30
# Outbound alert webhook timeout.
WEBHOOK_TIMEOUT_MS=5000
LOG_LEVEL=info

# --- Seeding (local development only) ------------------------------------
# Format: tg_live_<12 hex chars>_<32 base64url chars>
SEED_API_KEY="tg_live_0123456789ab_devdevdevdevdevdevdevdevdevdevde"

# --- App ------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"

# --- Notifications ----------------------------------------------------------
# 32 random bytes, base64. Required in production: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=""
# Email transport: Resend wins when both are set.
SMTP_URL="smtp://localhost:1025"
RESEND_API_KEY=""
EMAIL_FROM="Tollgate Alerts <alerts@tollgate.local>"
NOTIFY_HTTP_TIMEOUT_MS=8000
NOTIFY_MAX_ATTEMPTS=10
NOTIFY_BACKOFF_BASE_MS=2000
NOTIFY_BACKOFF_MAX_MS=1800000
NOTIFY_CONCURRENCY=16
NOTIFY_LEASE_MS=60000
# Only for local testing against private hosts. Never enable in production.
NOTIFY_ALLOW_PRIVATE_WEBHOOKS=false

# --- Anomaly engine -----------------------------------------------------------
ANOMALY_TICK_MS=15000
ANOMALY_SIGMA=3
ANOMALY_WINDOW_MINUTES=5
ANOMALY_BASELINE_MINUTES=60
ANOMALY_MIN_HISTORY_MINUTES=30
ANOMALY_MIN_WINDOW_SPEND_USD=1
ANOMALY_AUTO_QUARANTINE=true

# --- Worker -------------------------------------------------------------------
WORKER_HEALTH_PORT=9100
# Comma separated: notifications, anomaly (default both)
WORKER_ROLES="notifications,anomaly"

# --- Seeding (optional real destinations) --------------------------------------
SEED_SLACK_WEBHOOK_URL=""
SEED_TEAMS_WEBHOOK_URL=""
SEED_ALERT_EMAILS="oncall@acme.test,finops@acme.test"

# --- Authentication (Auth.js) ---------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Local development only: sign in as a seeded user by email. Ignored in production.
AUTH_DEV_LOGIN=false
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Billing (Stripe) -------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Fallback when prices carry no `tollgate_plan` metadata or tollgate_<plan> lookup key.
STRIPE_PRICE_PLAN_MAP='{"price_team_monthly":"TEAM","price_business_monthly":"BUSINESS"}'
# immediate | final_attempt | never
BILLING_SUSPEND_POLICY=immediate
